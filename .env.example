# Copy to .env (git-ignored) and fill in; docker compose reads it.

# First user, created at start-up only while there are no users yet (min. 8 characters).
# Left empty: add users later with  docker compose exec pricing-api python manage_users.py add <name>
TWR_ADMIN_USER=admin
TWR_ADMIN_PASSWORD=admin@123
# Optional
# TWR_JWT_SECRET=      a long random string; else one is generated and kept in the twr-state volume
# TWR_TOKEN_MINUTES=480
# HOST_PORT=8000       port on this machine
